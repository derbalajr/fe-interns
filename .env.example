VITE_API_URL=http://127.0.0.1:8000/api

# AI chat agent (streaming chat + floor-map navigation) — powers "Ask Keystone"
# and the onboarding assistant.
# OPTIONAL: the base URL defaults to http://10.10.67.51:8000 in code, so prod
