VITE_API_URL=http://127.0.0.1:8000/api

# AI chat agent (streaming chat + floor-map navigation) — powers "Ask Keystone"
# and the onboarding assistant. VITE_CHAT_API_BASE is the address the BROWSER
# can reach (it is baked into the floor_map URLs the API returns).
# The token is optional: local deployments run unauthenticated. If set, it is a
# single shared token, visible in the browser — do not use it in a public build.
VITE_CHAT_API_BASE=http://10.10.67.51:8000
VITE_CHAT_API_TOKEN=
